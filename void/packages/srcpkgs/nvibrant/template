# Template file for 'nvibrant'
pkgname=nvibrant
version=1.3.0
revision=1
archs="x86_64"
create_wrksrc=yes
skip_extraction="nvibrant-${version}-py3-none-manylinux_2_17_x86_64.whl license.txt"
hostmakedepends="python3-installer"
depends="python3 python3-packaging"
short_desc="NVIDIA digital vibrance and dithering on Wayland"
maintainer="Ryoku <releases@ryoku.dev>"
license="MIT"
homepage="https://github.com/Tremeschin/nvibrant"
distfiles="${homepage}/releases/download/v${version}/nvibrant-${version}-py3-none-manylinux_2_17_x86_64.whl
 ${homepage}/raw/v${version}/license.txt"
checksum="d60a080b52e4a16e16d16a7d4b6405a32a3fe1b8ee0df65dc3685213ef0393e8
 015b42dfc301724c0f8ac8de7658e36801a7a86463d91024bf173ee9ceec495f"
provides="nvibrant-bin-${version}_${revision}"
conflicts="nvibrant-bin>=0"
nostrip=yes

post_extract() {
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/nvibrant-${version}-py3-none-manylinux_2_17_x86_64.whl" .
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/license.txt" .
}

do_install() {
	python3 -m installer --destdir="${DESTDIR}" \
		"nvibrant-${version}-py3-none-manylinux_2_17_x86_64.whl"
	vlicense license.txt
}
