#!/bin/sh
exec 2>&1

. "${RYOKU_INIT_LIB:-/usr/lib/ryoku/runit}/wait-for"
load_session_env
BIN=${RYOKU_BIN_DIR:-/usr/bin}

wait_env WAYLAND_DISPLAY "${RYOKU_WAIT_WAYLAND:-60}" || exec sv down .
load_session_env
wait_service pipewire "${RYOKU_WAIT_PIPEWIRE:-60}" || exec sv down .
wait_service pipewire-pulse "${RYOKU_WAIT_PIPEWIRE:-60}" || exec sv down .
require_bin "$BIN/voxtype" || exec sv down .

exec "$BIN/voxtype" -q daemon
