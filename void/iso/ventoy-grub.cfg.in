set default=0
set timeout=15

menuentry "@RYOKU_ISO_TITLE@" {
    linux /boot/vmlinuz root=live:CDLABEL=VOID_LIVE ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=us locale.LANG=en_US.UTF-8 console=tty1 console=ttyS0,115200n8 rd.overlayfs=1
    initrd /boot/initrd
}

menuentry "@RYOKU_ISO_TITLE@ (RAM)" {
    linux /boot/vmlinuz root=live:CDLABEL=VOID_LIVE ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=us locale.LANG=en_US.UTF-8 rd.live.ram console=tty1 console=ttyS0,115200n8 rd.overlayfs=1
    initrd /boot/initrd
}

menuentry "@RYOKU_ISO_TITLE@ (graphics disabled)" {
    linux /boot/vmlinuz root=live:CDLABEL=VOID_LIVE ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=us locale.LANG=en_US.UTF-8 nomodeset console=tty1 console=ttyS0,115200n8 rd.overlayfs=1
    initrd /boot/initrd
}

menuentry "@RYOKU_ISO_TITLE@ with speech" {
    linux /boot/vmlinuz root=live:CDLABEL=VOID_LIVE ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=us locale.LANG=en_US.UTF-8 live.accessibility live.autologin console=tty1 console=ttyS0,115200n8 rd.overlayfs=1
    initrd /boot/initrd
}

menuentry "@RYOKU_ISO_TITLE@ with speech (RAM)" {
    linux /boot/vmlinuz root=live:CDLABEL=VOID_LIVE ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=us locale.LANG=en_US.UTF-8 live.accessibility live.autologin rd.live.ram console=tty1 console=ttyS0,115200n8 rd.overlayfs=1
    initrd /boot/initrd
}

menuentry "@RYOKU_ISO_TITLE@ with speech (graphics disabled)" {
    linux /boot/vmlinuz root=live:CDLABEL=VOID_LIVE ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=us locale.LANG=en_US.UTF-8 live.accessibility live.autologin nomodeset console=tty1 console=ttyS0,115200n8 rd.overlayfs=1
    initrd /boot/initrd
}

if [ "${grub_platform}" = "efi" ]; then
    menuentry "Run Memtest86+ (RAM test)" {
        linux /boot/memtest.efi
    }
    menuentry "UEFI Firmware Settings" {
        fwsetup
    }
else
    menuentry "Run Memtest86+ (RAM test)" {
        linux /boot/memtest.bin
    }
fi

menuentry "System restart" {
    reboot
}

menuentry "System shutdown" {
    halt
}
