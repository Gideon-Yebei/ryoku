#!/usr/bin/sh
#
# grub2-mkconfig snippet (/etc/grub.d/15_ryoku_snapshots). It only sources
# ryoku-snapshots.cfg next to grub.cfg, the "Ryoku snapshots" submenu that
# `ryoku boot-menu sync` rewrites after every snapshot, so a new snapshot never
# needs a grub2-mkconfig run and nothing touches Fedora's BLS entries. 15 puts
# the submenu right below Fedora's kernels (10_linux), above other systems and
# the firmware settings, where Limine shows its snapshots.
set -e

cat <<'EOF'
if [ -f "${config_directory}/ryoku-snapshots.cfg" ]; then
  source "${config_directory}/ryoku-snapshots.cfg"
fi
EOF
