#!/usr/bin/bash
#
# Puts Ryoku into Fedora's GRUB menu, keeping shim, GRUB and the kernels
# exactly as Fedora signs them.
#
#   install   copy the theme onto /boot, build its fonts, point
#             /etc/default/grub at them, and rebuild grub.cfg when any of it
#             changed or grub.cfg does not source the snapshot submenu yet
#             (ryoku-desktop %posttrans)
#   purge     undo all of it and drop the snapshot menu and its kernel copies
#             (ryoku-desktop %preun on removal; %postun rebuilds grub.cfg)
#
# The fonts are built onto /boot: left to itself, grub2-mkconfig loads one from
# /usr/share/grub, on the root filesystem GRUB cannot read on an encrypted
# install.
set -euo pipefail

grub_dir="${RYOKU_GRUB_DIR:-/boot/grub2}"
defaults="${RYOKU_GRUB_DEFAULTS:-/etc/default/grub}"
shipped="${RYOKU_GRUB_THEME_SRC:-/usr/share/ryoku/grub/theme}"
unifont="${RYOKU_GRUB_FONT_SRC:-/usr/share/grub/unicode.pf2}"
mkconfig="${RYOKU_GRUB_MKCONFIG:-grub2-mkconfig}"
mkfont="${RYOKU_GRUB_MKFONT:-grub2-mkfont}"
face="${RYOKU_GRUB_FONT_FACE:-}"
boot_dir=$(dirname "$grub_dir")
theme_dir="$grub_dir/themes/ryoku"

# The sizes theme.txt names, and the glyphs a boot menu shows: Latin, the
# punctuation snapper descriptions use, arrows and box drawing.
font_sizes=(16 20 24)
font_ranges=0x20-0x7E,0xA0-0x24F,0x2010-0x2027,0x2190-0x21FF,0x2500-0x259F

# set_key <KEY> <value>: set KEY="value" in /etc/default/grub; returns 0 when
# the file changed.
set_key() {
  local line="$1=\"$2\""
  grep -qxF -- "$line" "$defaults" && return 1
  if grep -q "^$1=" "$defaults"; then
    sed -i "s|^$1=.*|$line|" "$defaults"
  else
    printf '%s\n' "$line" >>"$defaults"
  fi
}

drop_key() {
  grep -q "^$1=" "$defaults" || return 1
  sed -i "/^$1=/d" "$defaults"
}

# terminal_output: the current GRUB_TERMINAL_OUTPUT value, unquoted.
terminal_output() {
  sed -n 's/^GRUB_TERMINAL_OUTPUT="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$defaults"
}

# copy_new <src> <dest>: move src over dest when the content differs; returns 0
# when it did.
copy_new() {
  if cmp -s "$1" "$2"; then
    rm -f "$1"
    return 1
  fi
  mv -f "$1" "$2"
}

# font_source: Ryoku's mono face when ryoku-extras installed it, else the Noto
# mono ryoku-desktop requires.
font_source() {
  local family file
  if [ -n "$face" ]; then
    [ -f "$face" ] && printf '%s\n' "$face"
    return
  fi
  for family in "SpaceMono Nerd Font Mono" "Noto Sans Mono"; do
    file=$(fc-list ":family=$family:style=Regular" file 2>/dev/null | head -n1)
    file=${file%%:*}
    [ -n "$file" ] && [ -f "$file" ] && { printf '%s\n' "$file"; return 0; }
  done
  return 1
}

# build_fonts <face>: build "Ryoku Mono" at every size as .new files; returns
# 0 only when each one came out, leaving nothing behind otherwise.
build_fonts() {
  local size out
  for size in "${font_sizes[@]}"; do
    out="$theme_dir/ryoku-mono-$size.pf2.new"
    if ! "$mkfont" -n "Ryoku Mono" -s "$size" -r "$font_ranges" -o "$out" "$1" 2>/dev/null || [ ! -s "$out" ]; then
      rm -f "$theme_dir"/ryoku-mono-*.pf2.new
      return 1
    fi
  done
}

# install_fonts: build "Ryoku Mono" at each size; returns 0 when a font
# changed. Without a source face, grub2-mkfont, or a face it can read, GRUB's
# own Unifont stands in and the theme's text falls back to it.
install_fonts() {
  local changed=1 src size out
  if src=$(font_source) && command -v "$mkfont" >/dev/null 2>&1 && build_fonts "$src"; then
    for size in "${font_sizes[@]}"; do
      out="$theme_dir/ryoku-mono-$size.pf2"
      copy_new "$out.new" "$out" && changed=0
    done
    font="$theme_dir/ryoku-mono-20.pf2"
  elif [ -f "$unifont" ]; then
    cp -f "$unifont" "$theme_dir/unicode.pf2.new"
    copy_new "$theme_dir/unicode.pf2.new" "$theme_dir/unicode.pf2" && changed=0
    font="$theme_dir/unicode.pf2"
  fi
  return "$changed"
}

# prune_theme: drop what an earlier theme left in the directory, so
# grub2-mkconfig does not keep loading a font no theme names; returns 0 when
# it removed something.
prune_theme() {
  local pruned=1 file name
  for file in "$theme_dir"/*; do
    [ -e "$file" ] || continue
    name=${file##*/}
    [ -e "$shipped/$name" ] && continue
    [ "$file" = "$font" ] && continue
    case "$name" in ryoku-mono-*.pf2) [ "$font" = "$theme_dir/ryoku-mono-20.pf2" ] && continue ;; esac
    rm -rf "$file"
    pruned=0
  done
  return "$pruned"
}

install_menu() {
  [ -d "$grub_dir" ] && [ -f "$defaults" ] || return 0
  mkdir -p "$theme_dir"
  # grub2-mkconfig loads the fonts and image modules the theme directory
  # needs, so a changed theme rebuilds grub.cfg too.
  local changed=1 file font=""
  for file in "$shipped"/*; do
    cp -f "$file" "$theme_dir/${file##*/}.new"
    copy_new "$theme_dir/${file##*/}.new" "$theme_dir/${file##*/}" && changed=0
  done
  install_fonts && changed=0
  prune_theme && changed=0

  # only Fedora's plain console becomes graphical; a serial or other chosen
  # terminal is kept, and the theme does not show there.
  case "$(terminal_output)" in
    "" | console) set_key GRUB_TERMINAL_OUTPUT gfxterm && changed=0 ;;
  esac
  if [ -n "$font" ]; then
    set_key GRUB_FONT "$font" && changed=0
  fi
  set_key GRUB_THEME "$theme_dir/theme.txt" && changed=0
  if [ "$changed" = 0 ] || ! grep -qs "ryoku-snapshots.cfg" "$grub_dir/grub.cfg"; then
    "$mkconfig" -o "$grub_dir/grub.cfg" >/dev/null
  fi
}

purge_menu() {
  if [ -f "$defaults" ] && grep -qxF "GRUB_THEME=\"$theme_dir/theme.txt\"" "$defaults"; then
    drop_key GRUB_THEME || :
    drop_key GRUB_FONT || :
    [ "$(terminal_output)" = gfxterm ] && set_key GRUB_TERMINAL_OUTPUT console || :
  fi
  rm -rf "$theme_dir" "$grub_dir/ryoku-snapshots.cfg" "$boot_dir/ryoku/snapshots"
  rmdir "$boot_dir/ryoku" 2>/dev/null || :
}

case "${1:-}" in
  install) install_menu ;;
  purge) purge_menu ;;
  *)
    echo "usage: ryoku-grub-menu install|purge" >&2
    exit 2
    ;;
esac
